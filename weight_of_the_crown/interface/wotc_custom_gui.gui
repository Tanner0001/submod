### Weight of the Crown - Exiles/Autonomy bar ###
### Read-only progress bar (per the design revision - no draggable slider).
### Meant to be added into countrypoliticsview.gui's existing layout via a
### containerWindowType insert, not loaded as a standalone window - copy the
### container below into the appropriate spot in that file, or reference it
### from a scripted_gui if you'd rather not touch a vanilla-adjacent file
### directly.

guiTypes = {
	containerWindowType = {
		name = "wotc_exile_autonomy_bar_container"
		position = { x = 0 y = 0 }
		size = { width = 260 height = 40 } # FIX: containerWindowType's size takes width/height, not x/y (confirmed via interface/browser.gui) - the x/y version broke parsing of the rest of this block

		iconType = {
			name = "wotc_exile_autonomy_bar_bg"
			spriteType = "GFX_wotc_exile_autonomy_bar_bg" # placeholder asset - see gfx/interface/README.md
			position = { x = 0 y = 0 }
		}

		# Multi-frame bar sprite (0-100 -> frame 1-100), same idiom as the
		# vanilla exile-legitimacy bar in countrypoliticsview.gui, driven by
		# the wotc_exile_influence variable via a scripted_gui that sets the
		# frame - implement that binding in
		# common/scripted_guis/wotc_scripted_gui.txt, not here.
		iconType = {
			name = "wotc_exile_autonomy_bar_fill"
			spriteType = "GFX_wotc_exile_autonomy_bar_fill" # placeholder asset
			position = { x = 4 y = 4 }
			frame = 50
		}

		instantTextboxType = {
			name = "wotc_exile_autonomy_bar_label"
			position = { x = 4 y = -14 }
			font = "hoi_18mbs"
			text = "EXILE_AUTONOMY_BAR_LABEL"
			maxWidth = 252
			maxHeight = 16
			format = center
		}
	}
}
