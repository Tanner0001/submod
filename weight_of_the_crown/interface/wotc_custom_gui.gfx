### Weight of the Crown - sprite definitions for the Exile/Autonomy bar ###
### Placeholder paths - real DDS/TGA art needs to be authored and dropped
### into gfx/interface/ before this loads without a missing-texture error.

spriteTypes = {
	spriteType = {
		name = "GFX_wotc_exile_autonomy_bar_bg"
		texturefile = "gfx/interface/wotc_exile_autonomy_bar_bg.dds"
	}

	# 100-frame horizontal filmstrip, one frame per percentage point of
	# wotc_exile_influence - same technique as vanilla's
	# GFX_subject_progressbar / GFX_exile_legitimacy_progressbar_long.
	spriteType = {
		name = "GFX_wotc_exile_autonomy_bar_fill"
		texturefile = "gfx/interface/wotc_exile_autonomy_bar_fill.dds"
		noOfFrames = 100
	}
}
